#!/usr/bin/env python3
"""Minimal terminal helper backed by Codex's persistent app-server daemon."""

from __future__ import annotations

import base64
import hashlib
import json
import os
import socket
import struct
import sys
import time
from typing import TYPE_CHECKING, Any

if TYPE_CHECKING:
    from pathlib import Path


VERSION = "0.1.0"


def _env_float(name: str, default: float) -> float:
    raw = os.environ.get(name)
    if raw is None:
        return default
    try:
        return float(raw)
    except ValueError:
        print(f"emma: invalid {name}={raw!r}", file=sys.stderr)
        raise SystemExit(2) from None


def _idle_timeout_seconds() -> float:
    name = "EMMA_IDLE_TIMEOUT" if "EMMA_IDLE_TIMEOUT" in os.environ else "EMMA_TIMEOUT"
    return _env_float(name, 120.0)


MODEL = os.environ.get("EMMA_MODEL", "gpt-5.6-luna")
# EMMA_TIMEOUT (aliased as EMMA_IDLE_TIMEOUT) is a per-recv *idle* timeout:
# how long a single socket read may block before giving up. It is not a cap
# on the whole response, so a turn that keeps emitting tokens, even slowly,
# never trips it. EMMA_TURN_TIMEOUT is the separate wall-clock deadline for
# an entire turn, from turn/start to completion.
IDLE_TIMEOUT_SECONDS = _idle_timeout_seconds()
TURN_TIMEOUT_SECONDS = _env_float("EMMA_TURN_TIMEOUT", 300.0)
WORKING_DIRECTORY = os.environ.get("EMMA_CWD", "/tmp")
DEVELOPER_INSTRUCTIONS = """\
You are Emma, a fast terminal reference assistant for Ubuntu and Unix-like systems.
Answer the user's question directly and concisely. Prefer an exact command followed
by at most a short explanation. Use plain terminal text without Markdown code
fences or decorative formatting. Do not inspect files, run commands, call tools,
or access external services. If the answer depends on missing details, state the
assumption briefly.
"""
WEBSOCKET_GUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
# The socket is a trusted local peer, but a corrupt or malicious length
# header (the 127-length marker allows up to 2^64) shouldn't make
# _read_exact loop allocating memory forever.
MAX_FRAME_BYTES = 32 * 1024 * 1024


class EmmaError(RuntimeError):
    pass


class AppServerConnection:
    def __init__(self, socket_path: Path) -> None:
        self._next_id = 1
        self._pending: list[dict[str, Any]] = []
        self._incoming = bytearray()
        self._socket = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self._socket.settimeout(IDLE_TIMEOUT_SECONDS)

        try:
            self._socket.connect(str(socket_path))
            self._upgrade_to_websocket()
        except Exception:
            self.close()
            raise

    def initialize(self) -> dict[str, Any]:
        """Send the app-server `initialize`/`initialized` handshake.

        Split out from __init__ (rather than transport connect + upgrade
        only) so --timing can attribute this JSON-RPC round trip
        separately from the raw socket connect and WebSocket upgrade.
        """
        try:
            result = self.request(
                "initialize",
                {
                    "clientInfo": {
                        "name": "emma",
                        "title": "Emma Terminal Assistant",
                        "version": VERSION,
                    }
                },
            )
            self.send({"method": "initialized", "params": {}})
            return result
        except Exception:
            self.close()
            raise

    def _upgrade_to_websocket(self) -> None:
        key = base64.b64encode(os.urandom(16)).decode("ascii")
        request = (
            "GET / HTTP/1.1\r\n"
            "Host: localhost\r\n"
            "Upgrade: websocket\r\n"
            "Connection: Upgrade\r\n"
            f"Sec-WebSocket-Key: {key}\r\n"
            "Sec-WebSocket-Version: 13\r\n"
            "\r\n"
        )
        self._socket.sendall(request.encode("ascii"))

        response = bytearray()
        while b"\r\n\r\n" not in response:
            chunk = self._socket.recv(4096)
            if not chunk:
                raise EmmaError("Codex closed the socket during WebSocket upgrade")
            response.extend(chunk)
            if len(response) > 65536:
                raise EmmaError("Codex returned an oversized WebSocket handshake")

        raw_headers, _, remainder = response.partition(b"\r\n\r\n")
        self._incoming.extend(remainder)
        lines = raw_headers.decode("latin-1").split("\r\n")
        if not lines or " 101 " not in f" {lines[0]} ":
            raise EmmaError(f"WebSocket upgrade failed: {lines[0] if lines else ''}")

        headers: dict[str, str] = {}
        for line in lines[1:]:
            if ":" in line:
                name, value = line.split(":", 1)
                headers[name.strip().lower()] = value.strip()
        expected = base64.b64encode(
            hashlib.sha1((key + WEBSOCKET_GUID).encode("ascii")).digest()
        ).decode("ascii")
        if headers.get("sec-websocket-accept") != expected:
            raise EmmaError("Codex returned an invalid WebSocket handshake")

    def _send_frame(self, opcode: int, payload: bytes = b"") -> None:
        first = 0x80 | opcode
        length = len(payload)
        if length < 126:
            header = struct.pack("!BB", first, 0x80 | length)
        elif length <= 0xFFFF:
            header = struct.pack("!BBH", first, 0x80 | 126, length)
        else:
            header = struct.pack("!BBQ", first, 0x80 | 127, length)

        mask = os.urandom(4)
        masked = bytes(byte ^ mask[index % 4] for index, byte in enumerate(payload))
        self._socket.sendall(header + mask + masked)

    def _read_exact(self, size: int) -> bytes:
        while len(self._incoming) < size:
            try:
                chunk = self._socket.recv(max(4096, size - len(self._incoming)))
            except socket.timeout as exc:
                raise EmmaError(
                    f"Codex did not respond within {IDLE_TIMEOUT_SECONDS:g} seconds (idle timeout)"
                ) from exc
            if not chunk:
                raise EmmaError("Codex app-server closed the connection")
            self._incoming.extend(chunk)

        result = bytes(self._incoming[:size])
        del self._incoming[:size]
        return result

    def _read_text_frame(self) -> str:
        fragments = bytearray()
        fragmented = False

        while True:
            first, second = self._read_exact(2)
            finished = bool(first & 0x80)
            opcode = first & 0x0F
            masked = bool(second & 0x80)
            length = second & 0x7F
            if length == 126:
                length = struct.unpack("!H", self._read_exact(2))[0]
            elif length == 127:
                length = struct.unpack("!Q", self._read_exact(8))[0]

            if length > MAX_FRAME_BYTES:
                raise EmmaError(
                    f"Codex sent an oversized WebSocket frame ({length} bytes)"
                )

            mask = self._read_exact(4) if masked else b""
            payload = self._read_exact(length)
            if masked:
                payload = bytes(
                    byte ^ mask[index % 4] for index, byte in enumerate(payload)
                )

            if opcode == 0x8:
                raise EmmaError("Codex app-server closed the WebSocket")
            if opcode == 0x9:
                self._send_frame(0xA, payload)
                continue
            if opcode == 0xA:
                continue
            if opcode == 0x1:
                fragments = bytearray(payload)
                fragmented = not finished
            elif opcode == 0x0 and fragmented:
                fragments.extend(payload)
                fragmented = not finished
            else:
                continue

            if finished:
                return fragments.decode("utf-8")

    def send(self, message: dict[str, Any]) -> None:
        payload = json.dumps(message, separators=(",", ":")).encode("utf-8")
        self._send_frame(0x1, payload)

    def read_message(self) -> dict[str, Any]:
        try:
            message = json.loads(self._read_text_frame())
        except json.JSONDecodeError as exc:
            raise EmmaError(f"Codex returned invalid protocol data: {exc}") from exc

        if os.environ.get("EMMA_DEBUG"):
            print(json.dumps(message, indent=2), file=sys.stderr)
        return message

    def request(self, method: str, params: dict[str, Any]) -> dict[str, Any]:
        request_id = self._next_id
        self._next_id += 1
        self.send({"method": method, "id": request_id, "params": params})

        while True:
            message = self.read_message()
            if self._reply_if_inbound_request(message):
                continue
            if message.get("id") != request_id:
                self._pending.append(message)
                continue

            if "error" in message:
                error = message["error"]
                if isinstance(error, dict):
                    detail = error.get("message") or json.dumps(error)
                else:
                    detail = str(error)
                raise EmmaError(f"{method} failed: {detail}")

            result = message.get("result")
            return result if isinstance(result, dict) else {}

    def next_event(self) -> dict[str, Any]:
        while True:
            message = self._pending.pop(0) if self._pending else self.read_message()
            if self._reply_if_inbound_request(message):
                continue
            return message

    def _reply_if_inbound_request(self, message: dict[str, Any]) -> bool:
        """Reply to a server-initiated request so it can't deadlock us.

        A message carrying both "id" and "method" is a request *from* the
        app-server (an approval prompt, an auth refresh, a capability
        probe, ...), not a response or a notification. Emma doesn't
        implement any server-initiated methods, so answer with a
        JSON-RPC "method not found" error instead of silently dropping it
        — dropping it would leave the server waiting for a reply Emma will
        never send, while Emma waits for a message the server will never
        send, and both sides hang until the idle timeout.
        """
        if "id" in message and "method" in message:
            self.send(
                {
                    "id": message["id"],
                    "error": {"code": -32601, "message": "method not found"},
                }
            )
            return True
        return False

    def interrupt_turn(self, thread_id: str, turn_id: str | None) -> None:
        """Best-effort request to stop a turn after a local Ctrl-C.

        This is not on the hot path and must never itself raise or block
        for long: the caller is already unwinding a KeyboardInterrupt, and
        the socket is about to be closed regardless of whether the daemon
        acknowledges the interrupt.
        """
        try:
            # TODO: confirm method name against the app-server protocol;
            # "turn/interrupt" is a best guess (turn/abort is the other
            # plausible name). Sent best-effort — if the server doesn't
            # recognize it, the reply is just a JSON-RPC error we ignore.
            self.send(
                {
                    "method": "turn/interrupt",
                    "params": {"threadId": thread_id, "turnId": turn_id},
                }
            )
            original_timeout = self._socket.gettimeout()
            self._socket.settimeout(0.5)
            deadline = time.monotonic() + 2.0
            try:
                while time.monotonic() < deadline:
                    self.read_message()
            except (EmmaError, OSError):
                pass
            finally:
                try:
                    self._socket.settimeout(original_timeout)
                except OSError:
                    pass
        except Exception:
            pass

    def close(self) -> None:
        if getattr(self, "_socket", None) is not None:
            try:
                self._send_frame(0x8)
            except OSError:
                pass
            self._socket.close()

    def __enter__(self) -> AppServerConnection:
        return self

    def __exit__(self, *_: object) -> None:
        self.close()


def find_codex() -> str:
    from pathlib import Path

    override = os.environ.get("EMMA_CODEX")
    if override:
        return str(Path(override).expanduser())
    import shutil

    codex = shutil.which("codex")
    if not codex:
        raise EmmaError("cannot find `codex` on PATH")
    return codex


def find_socket() -> Path:
    from pathlib import Path

    override = os.environ.get("EMMA_SOCKET")
    if override:
        return Path(override).expanduser()
    codex_home = Path(os.environ.get("CODEX_HOME", "~/.codex")).expanduser()
    return codex_home / "app-server-control" / "app-server-control.sock"


def start_daemon(codex: str) -> None:
    import subprocess

    try:
        result = subprocess.run(
            [codex, "app-server", "daemon", "start"],
            capture_output=True,
            text=True,
            timeout=20,
            check=False,
        )
    except subprocess.TimeoutExpired as exc:
        raise EmmaError("timed out starting the Codex app-server daemon") from exc

    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip()
        raise EmmaError(f"could not start the Codex app-server daemon: {detail}")


def connect() -> AppServerConnection:
    socket_path = find_socket()
    try:
        return AppServerConnection(socket_path)
    except (EmmaError, OSError):
        # Codex is only resolved here, on the cold path where the daemon
        # actually needs to be started. A warm invocation against an
        # already-running daemon never pays a PATH scan and never fails
        # just because `codex` isn't on this shell's PATH.
        codex = find_codex()
        start_daemon(codex)
        return _connect_with_retry(socket_path)


def _connect_with_retry(socket_path: Path) -> AppServerConnection:
    """Poll for the daemon's socket to accept connections after start_daemon().

    `codex app-server daemon start` returning success only means the start
    command exited; it does not guarantee the socket is bound and accepting
    yet. Retry with exponential backoff instead of a single immediate retry.
    """
    delay = 0.05
    deadline = time.monotonic() + 5.0
    last_exc: BaseException | None = None
    while True:
        try:
            return AppServerConnection(socket_path)
        except (EmmaError, OSError) as exc:
            last_exc = exc
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        time.sleep(min(delay, remaining))
        delay = min(delay * 2, 0.5)
    raise EmmaError(
        "Codex app-server daemon started but never accepted a connection"
    ) from last_exc


# Newest Codex CLI release the app-server protocol was verified against
# (see README). The initialize response's exact shape for reporting a
# server version isn't confirmed locally — Codex isn't installed in this
# environment — so this checks the couple of plausible locations
# defensively and skips silently if neither is present.
SUPPORTED_CODEX_VERSION = (0, 150)


def _warn_if_codex_newer(initialize_result: dict[str, Any]) -> None:
    version_str: Any = None
    server_info = initialize_result.get("serverInfo")
    if isinstance(server_info, dict):
        version_str = server_info.get("version")
    if not isinstance(version_str, str):
        version_str = initialize_result.get("version")
    if not isinstance(version_str, str):
        return

    parts = version_str.split(".")
    try:
        version = (int(parts[0]), int(parts[1]))
    except (IndexError, ValueError):
        return

    if version > SUPPORTED_CODEX_VERSION:
        supported = ".".join(str(part) for part in SUPPORTED_CODEX_VERSION)
        print(
            f"emma: Codex {version_str} is newer than emma expects "
            f"(tested against {supported}.x); protocol may have changed",
            file=sys.stderr,
        )


def ask(prompt: str, *, timing: bool) -> None:
    started = time.monotonic()
    # Cumulative phase timestamps for --timing, in the order they're
    # expected to complete: connect, initialize, thread_start, turn_start,
    # first_output, total. Each value is seconds since `started`.
    timings: dict[str, float] = {}

    with connect() as server:
        timings["connect"] = time.monotonic() - started
        thread_id: str | None = None
        turn_id: str | None = None
        wrote_output = False
        try:
            initialize_result = server.initialize()
            timings["initialize"] = time.monotonic() - started
            _warn_if_codex_newer(initialize_result)

            thread_result = server.request(
                "thread/start",
                {
                    "model": MODEL,
                    "cwd": WORKING_DIRECTORY,
                    "approvalPolicy": "never",
                    "sandbox": "read-only",
                    "ephemeral": True,
                    "developerInstructions": DEVELOPER_INSTRUCTIONS,
                    # NOTE: reasoning effort is set both here
                    # (config.model_reasoning_effort) and again below on
                    # turn/start (effort). It's unconfirmed which one the
                    # app-server actually honors — nothing in the
                    # initialize response or a local Codex schema settled
                    # it, and Codex isn't installed in this environment to
                    # check empirically. Left as both rather than guessing
                    # and silently dropping the one that matters.
                    "config": {
                        "model_reasoning_effort": "low",
                        "model_verbosity": "low",
                    },
                },
            )
            thread = thread_result.get("thread", {})
            thread_id = thread.get("id") if isinstance(thread, dict) else None
            if not isinstance(thread_id, str):
                raise EmmaError("thread/start returned no thread id")
            timings["thread_start"] = time.monotonic() - started

            turn_result = server.request(
                "turn/start",
                {
                    "threadId": thread_id,
                    # See the NOTE on thread/start's config above.
                    "effort": "low",
                    "input": [{"type": "text", "text": prompt}],
                },
            )
            turn = turn_result.get("turn", {})
            turn_id = turn.get("id") if isinstance(turn, dict) else None
            timings["turn_start"] = time.monotonic() - started
            streamed_items: set[str] = set()
            # Wall-clock deadline for the whole turn, separate from the
            # per-recv idle timeout: a turn that keeps emitting tokens
            # slowly would never trip the idle timeout, and an
            # unrecognized terminal state must still not hang forever.
            turn_deadline = time.monotonic() + TURN_TIMEOUT_SECONDS

            while True:
                if time.monotonic() > turn_deadline:
                    raise EmmaError(
                        f"Codex turn exceeded the {TURN_TIMEOUT_SECONDS:g}s total turn deadline"
                    )

                event = server.next_event()
                method = event.get("method")
                params = event.get("params", {})

                if "error" in event:
                    error = event["error"]
                    detail = error.get("message") if isinstance(error, dict) else error
                    raise EmmaError(f"Codex reported an error: {detail}")

                if not isinstance(params, dict):
                    continue

                event_thread_id = params.get("threadId")
                event_turn_id = params.get("turnId")
                if event_thread_id not in (None, thread_id):
                    continue
                if turn_id and event_turn_id not in (None, turn_id):
                    continue

                if method == "item/agentMessage/delta":
                    delta = params.get("delta")
                    item_id = params.get("itemId")
                    if isinstance(delta, str) and delta:
                        timings.setdefault("first_output", time.monotonic() - started)
                        sys.stdout.write(delta)
                        sys.stdout.flush()
                        wrote_output = True
                    if isinstance(item_id, str):
                        streamed_items.add(item_id)

                elif method == "item/completed":
                    item = params.get("item", {})
                    if not isinstance(item, dict) or item.get("type") != "agentMessage":
                        continue
                    item_id = item.get("id")
                    text = item.get("text")
                    if item_id not in streamed_items and isinstance(text, str) and text:
                        timings.setdefault("first_output", time.monotonic() - started)
                        sys.stdout.write(text)
                        sys.stdout.flush()
                        wrote_output = True

                elif method == "turn/completed":
                    completed_turn = params.get("turn", {})
                    if isinstance(completed_turn, dict):
                        status = completed_turn.get("status")
                        if status == "failed":
                            error = completed_turn.get("error")
                            raise EmmaError(f"Codex turn failed: {error}")
                    break

                elif method == "turn/aborted":
                    raise EmmaError("Codex turn was aborted")

                elif method == "turn/failed":
                    raise EmmaError(f"Codex turn failed: {params.get('error')}")

                elif method == "thread/error":
                    raise EmmaError(f"Codex thread error: {params.get('error')}")

                elif method == "turn/started":
                    # Non-terminal: emitted right after turn/start as the
                    # turn begins. Not a signal to stop reading events.
                    continue

                elif isinstance(method, str) and method.startswith("turn/"):
                    # Any other turn/* method is a terminal state this file
                    # doesn't know the name of yet; end the turn rather than
                    # hang until the idle or total-turn timeout.
                    break
        except KeyboardInterrupt:
            # The daemon is still generating tokens for this turn even
            # though nobody is reading them. Ask it to stop before
            # re-raising so a Ctrl-C doesn't burn paid-for output on a
            # thread nobody will see the rest of.
            if thread_id is not None:
                server.interrupt_turn(thread_id, turn_id)
            raise
        finally:
            # Runs on the error path too, so a mid-stream failure never
            # leaves the cursor mid-line for the next shell prompt.
            if wrote_output:
                sys.stdout.write("\n")
                sys.stdout.flush()

    finished = time.monotonic()
    timings.setdefault("first_output", finished - started)
    timings["total"] = finished - started
    if timing:
        parts = " ".join(f"{name}={value:.3f}s" for name, value in timings.items())
        print(f"emma timing: {parts}", file=sys.stderr)


USAGE = "Usage: emma [--timing] [--] <question>"
HELP_TEXT = f"""{USAGE}

Ask Codex's app-server a quick terminal question and stream the answer.

Options:
  --timing       print phase-by-phase timing to stderr
  -h, --help     show this help message and exit
  --version      show version and exit
  --             treat all remaining arguments as the question, even
                 if they start with a dash

The question may come from argv, from piped stdin, or both: if stdin is
piped and argv is also given, the piped input is appended to the argv
question as additional context (e.g. `git log | emma what changed here`).
"""


def parse_args(argv: list[str]) -> tuple[str, list[str], bool]:
    """Parse argv into (action, question_parts, timing).

    action is "help", "version", or "run". question_parts and timing are
    only meaningful for "run".
    """
    timing = False
    question_parts: list[str] = []
    end_of_options = False

    for arg in argv:
        if not end_of_options:
            if arg == "--":
                end_of_options = True
                continue
            if arg == "--timing":
                timing = True
                continue
            if arg in ("-h", "--help"):
                return "help", [], False
            if arg == "--version":
                return "version", [], False
        question_parts.append(arg)

    return "run", question_parts, timing


def _stdin_is_piped() -> bool:
    """True only for stdin actually redirected from a pipe or a file.

    isatty() alone isn't enough: a non-tty stdin that's neither a pipe nor
    a regular file (a character device, a socket, ...) has no EOF coming,
    so reading it would block forever. That's a real invocation shape, not
    just a test artifact — a plain `emma <question>` run from inside
    another long-lived process can inherit exactly this kind of stdin.
    """
    if sys.stdin.isatty():
        return False
    import stat

    try:
        mode = os.fstat(sys.stdin.fileno()).st_mode
    except OSError:
        return False
    return stat.S_ISFIFO(mode) or stat.S_ISREG(mode)


def main(argv: list[str]) -> int:
    action, question_parts, timing = parse_args(argv)
    if action == "help":
        print(HELP_TEXT)
        return 0
    if action == "version":
        print(VERSION)
        return 0

    have_stdin = _stdin_is_piped()
    if not question_parts and not have_stdin:
        print(USAGE, file=sys.stderr)
        return 2

    argv_prompt = " ".join(question_parts).strip()
    stdin_context = sys.stdin.read().strip() if have_stdin else ""

    if argv_prompt and stdin_context:
        prompt = f"{argv_prompt}\n\n--- piped input ---\n{stdin_context}"
    else:
        prompt = argv_prompt or stdin_context

    if not prompt:
        print("emma: question cannot be empty", file=sys.stderr)
        return 2

    try:
        ask(prompt, timing=timing)
        return 0
    except KeyboardInterrupt:
        print("\nemma: interrupted", file=sys.stderr)
        return 130
    except EmmaError as exc:
        print(f"emma: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
